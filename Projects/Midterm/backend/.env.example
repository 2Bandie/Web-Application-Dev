# Export these variables in your shell; Django does not auto-load this file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Render: set DEBUG=0, generate a real secret, and use PostgreSQL.
# DATABASE_URL is private. Enter it only in Render's environment settings.
# DATABASE_URL=postgresql://... (use Render's Internal Database URL)
# CORS_ALLOWED_ORIGINS=https://2bandie.github.io
# RENDER_EXTERNAL_HOSTNAME is provided automatically by Render.
